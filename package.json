{
  "name": "databricks-mcp",
  "version": "1.0.0",
  "description": "Standalone MCP (Model Context Protocol) server for Databricks SQL using @databricks/sql",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "databricks-mcp": "dist/index.js",
    "databricks-db-mcp": "dist/index.js",
    "databricks-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "keywords": [
    "databricks",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "sql",
    "claude-code",
    "opencode",
    "antigravity",
    "cursor"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victoprincipe/databricks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/victoprincipe/databricks-mcp/issues"
  },
  "homepage": "https://github.com/victoprincipe/databricks-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@databricks/sql": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
